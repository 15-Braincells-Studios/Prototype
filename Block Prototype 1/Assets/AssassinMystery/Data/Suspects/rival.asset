MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d7e76c79f1aa7df4391b0909e0ea0543, type: 3}
  m_Name: rival
  m_EditorClassIdentifier: AssassinMystery::AssassinMystery.SuspectData
  id: rival
  displayName: Lady Seraphine Dunmore
  role: Noble Rival
  profile: Head of House Dunmore, the Crown's oldest rivals. Wealthy, sharp and openly
    ambitious.
  coatColor: {r: 0.12156863, g: 0.36862746, b: 0.2627451, a: 1}
  accentColor: {r: 0.8509804, g: 0.7607843, b: 0.47843137, a: 1}
  skinColor: {r: 0.92156863, g: 0.8039216, b: 0.70980394, a: 1}
  headwear: 2
  heightScale: 1
  beard: 0
  greeting: So the Captain has hired a hound. How quaint.
  topics:
  - question: What is your quarrel with the Crown?
    response: My grandfather should have been king. Everyone knows it. But I prefer
      to win my battles with gold, detective, not daggers.
    recordInNotebook: 1
    requiresClue: {fileID: 0}
    revealsClue: {fileID: 0}
  - question: Where were you this afternoon?
    response: Dressing. It takes hours. My maid will confirm it, though you will
      find her as dull as I do.
    recordInNotebook: 1
    requiresClue: {fileID: 0}
    revealsClue: {fileID: 0}
  - question: Do you know Master Vale?
    response: The Treasurer? We have... dealings. He is a man who likes money far
      more than he has it.
    recordInNotebook: 1
    requiresClue: {fileID: 0}
    revealsClue: {fileID: 0}
  - question: Your letter to Master Vale.
    response: You read my letters? ...Yes. He borrowed four hundred crowns from me,
      to cover Crown money he had already spent, I suspect. I want it back before
      the audit exposes him. Why would I want the Queen dead? Her audit is what makes
      him pay me.
    recordInNotebook: 1
    requiresClue: {fileID: 11400000, guid: eb86f676fa092e64e8cd061c2f84bef0, type: 2}
    revealsClue: {fileID: 0}
  - question: Your meetings with Lord Halvard.
    response: A matter of marriage, not murder. My son and the Queen's niece. Ask
      Halvard if you doubt me.
    recordInNotebook: 1
    requiresClue: {fileID: 11400000, guid: a430af667ff8e1142b8996c52b0b6c52, type: 2}
    revealsClue: {fileID: 0}
