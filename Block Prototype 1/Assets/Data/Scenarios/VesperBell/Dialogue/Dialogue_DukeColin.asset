--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a33d78d4f46cd574a838d575a6c13330, type: 3}
  m_Name: Dialogue_DukeColin
  m_EditorClassIdentifier: Assembly-CSharp::PreventTheMurder.DialogueData
  greeting:
  - text: What do you want? I am a busy man.
    clueToUnlock: {fileID: 0}
    requiredClue: {fileID: 0}
  topics:
  - title: Ask about last night
    requiredClue: {fileID: 0}
    lines:
    - text: I was at cards until late. Ask anyone.
      clueToUnlock: {fileID: 0}
      requiredClue: {fileID: 0}
  - title: Ask about the King
    requiredClue: {fileID: 0}
    lines:
    - text: My dear uncle? We are very close.
      clueToUnlock: {fileID: 0}
      requiredClue: {fileID: 0}
    - text: If you want someone to watch, watch Brother Pruitt. He is forever mixing
        potions for the King.
      clueToUnlock: {fileID: 11400000, guid: 00d7d54ac9443b94f92d5c9fed73132c, type: 2}
      requiredClue: {fileID: 0}
  - title: Ask about the kitchens
    requiredClue: {fileID: 0}
    lines:
    - text: I went down for a bite to eat. Is that a crime now?
      clueToUnlock: {fileID: 0}
      requiredClue: {fileID: 0}
  - title: Confront him with the debt note
    requiredClue: {fileID: 11400000, guid: 049572dc11197f84d994117328816e54, type: 2}
    lines:
    - text: Where did you get that? Give it here!
      clueToUnlock: {fileID: 0}
      requiredClue: {fileID: 0}
    - text: My debts will be settled soon enough. Very soon.
      clueToUnlock: {fileID: 11400000, guid: 475ac88d2e86551408fba1ed0f0fcfcb, type: 2}
      requiredClue: {fileID: 0}
  farewellLabel: Farewell.
