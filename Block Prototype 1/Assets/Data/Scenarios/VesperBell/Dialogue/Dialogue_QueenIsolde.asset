  m_Script: {fileID: 11500000, guid: a33d78d4f46cd574a838d575a6c13330, type: 3}
  m_Name: Dialogue_QueenIsolde
  m_EditorClassIdentifier: Assembly-CSharp::PreventTheMurder.DialogueData
  greeting:
  - text: Good evening. The hall feels restless tonight.
    clueToUnlock: {fileID: 0}
    requiredClue: {fileID: 0}
  topics:
  - title: Ask about last night
    requiredClue: {fileID: 0}
    lines:
    - text: I slept poorly. Aldric sat up late, writing by candlelight.
      clueToUnlock: {fileID: 0}
      requiredClue: {fileID: 0}
  - title: Ask about Duke Colin
    requiredClue: {fileID: 0}
    lines:
    - text: My husband's nephew is charming, when he wants something.
      clueToUnlock: {fileID: 0}
      requiredClue: {fileID: 0}
    - text: This morning I heard him in the courtyard, arguing with a stranger about
        money.
      clueToUnlock: {fileID: 0}
      requiredClue: {fileID: 0}
    - text: He said, "You will have it all by the new moon." I did not like his tone.
      clueToUnlock: {fileID: 11400000, guid: 91c3284bddc12864b8fb06beac6a721d, type: 2}
      requiredClue: {fileID: 0}
  - title: Ask about the King
    requiredClue: {fileID: 0}
    lines:
    - text: He is stubborn, but he means well. He has big news for the court tonight.
      clueToUnlock: {fileID: 0}
      requiredClue: {fileID: 0}
  farewellLabel: Farewell.
